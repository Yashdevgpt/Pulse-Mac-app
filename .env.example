## ─── AI providers ───────────────────────────────────────────────────
## Gemini + OpenRouter API keys are entered through the in-app
## Admin → AI Keys panel (stored in your browser's localStorage).
## They are NOT read from this file. Only model + dimension defaults
## live here so server-side helpers can stay in one place.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

## ─── Supabase (vector memory) ───────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_for_local_server_only

## ─── Firebase web config (client) ───────────────────────────────────
## Override per environment so keys can be rotated without code changes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

## ─── Bootstrap admin (client) ───────────────────────────────────────
## Email of the user who is auto-promoted to admin on first sign-in.
## MUST match the bootstrapEmail() value in firestore.rules.
VITE_BOOTSTRAP_ADMIN_EMAIL=
